---
// src/layouts/Layout.astro
import "../styles/global.css";
import Spotlights from "../components/Spotlights.astro";
import CustomCursor from "../components/CustomCursor.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

// Nav items
const navLinks = [
  { name: "HOME", url: "#", active: true },
  { name: "ABOUT", url: "#about", active: false },
  { name: "TECH", url: "#tech", active: false },
  { name: "PROJECTS", url: "#projects", active: false },
  { name: "EDUCATION", url: "#education", active: false },
  { name: "CAREER", url: "#career", active: false },
  { name: "CONTACT", url: "#contact", active: false },
];
---

<html lang="en" class="scroll-smooth scroll-pt-14 lg:scroll-pt-16">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=JetBrains+Mono:wght@100..800&family=Space+Grotesk:wght@300..700&family=Permanent+Marker&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body
    class="selection:bg-white/20 selection:text-white bg-black min-h-screen relative overflow-x-hidden"
  >
    <Spotlights />

    <CustomCursor />

    <input
      type="checkbox"
      id="nav-toggle"
      class="fixed opacity-0 w-px h-px pointer-events-none peer"
    />

    <nav
      class="fixed top-0 left-0 right-0 z-50 flex items-center px-5 lg:px-12
             h-14 lg:h-16
             bg-black/60 backdrop-blur-md border-b border-white/25
             pointer-events-none"
    >
      <a
        href="#"
        class="relative z-10 text-3xl md:text-2xl text-gray-200 hover:text-white transition-colors tracking-widest -mt-2 pointer-events-auto"
        style="font-family: 'Permanent Marker', cursive;"
      >
        JAGARDEV
      </a>

      <label
        for="nav-toggle"
        class="xl:hidden ml-auto pointer-events-auto cursor-pointer text-gray-400 hover:text-white transition-colors"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>

      <div
        class="pointer-events-auto hidden xl:flex items-center gap-8 xl:gap-16 absolute left-1/2 -translate-x-1/2 w-max"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.url}
              class="nav-link desktop-link text-[20px] font-script font-extrabold tracking-[0.2em] uppercase transition-colors duration-300 text-gray-500 hover:text-gray-200"
            >
              {link.name}
            </a>
          ))
        }
      </div>
    </nav>

    <div
      class="xl:hidden fixed inset-0 z-[60] bg-black/95 backdrop-blur-sm
             flex flex-col items-center justify-center gap-10
             opacity-0 pointer-events-none
             peer-checked:opacity-100 peer-checked:pointer-events-auto
             transition-opacity duration-300"
    >
      <label
        for="nav-toggle"
        class="absolute top-5 right-5 cursor-pointer text-gray-400 hover:text-white transition-colors"
      >
        <svg
          class="w-7 h-7"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </label>

      <a
        href="#"
        class="absolute top-4 left-5 text-2xl text-gray-200 tracking-widest"
        style="font-family: 'Permanent Marker', cursive;"
      >
        JAGARDEV
      </a>

      {
        navLinks.map((link) => (
          <a
            href={link.url}
            class="nav-link mobile-link text-2xl font-script font-extrabold tracking-[0.2em] uppercase transition-colors duration-300 cursor-pointer text-gray-400 hover:text-white"
          >
            {link.name}
          </a>
        ))
      }
    </div>

    <main
      class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 pt-20 xl:pt-52 pb-16 xl:pb-20 flex flex-col gap-16 xl:gap-32"
    >
      <slot />
    </main>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        
        // --- 1. NAVIGATION ACTIVE STATE TRACKING ---
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll(".nav-link");
        const mobileLinks = document.querySelectorAll(".mobile-link");
        const navToggle = document.getElementById("nav-toggle") as HTMLInputElement;

        // Close mobile menu on click
        mobileLinks.forEach((link) => {
          link.addEventListener("click", () => {
            if (navToggle) navToggle.checked = false;
          });
        });

        const NAVBAR_OFFSET = 120; // px below viewport top to count as "entered"

        const updateActiveLink = () => {
          let activeId = "home"; // default when at the very top

          sections.forEach((section) => {
            const id = section.getAttribute("id");
            if (!id) return;
            const rect = section.getBoundingClientRect();
            // Section is "current" when its top has scrolled above the offset
            if (rect.top <= NAVBAR_OFFSET) {
              activeId = id;
            }
          });

          navLinks.forEach((link) => {
            // Remove active state
            link.classList.remove("text-white");

            // Restore default inactive colors per link type
            if (link.classList.contains("desktop-link")) {
              link.classList.add("text-gray-500");
            } else if (link.classList.contains("mobile-link")) {
              link.classList.add("text-gray-400");
            }

            // Apply active state to the matching link
            const href = link.getAttribute("href");
            if (
              href === `#${activeId}` ||
              (activeId === "home" && (href === "#" || href === "#home"))
            ) {
              link.classList.add("text-white");
              link.classList.remove("text-gray-500", "text-gray-400");
            }
          });
        };

        // Throttle with rAF so we run at most once per frame
        let ticking = false;
        window.addEventListener("scroll", () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(() => {
              updateActiveLink();
              ticking = false;
            });
          }
        }, { passive: true });

        // Set correct initial state on load
        updateActiveLink();

        // --- 2. PREMIUM REVEAL ANIMATION (Intersection Observer) ---
        const revealOptions = {
          root: null,
          // Negative rootMargin ensures the effect doesn't trigger until the element 
          // is 10% into the viewport from the bottom, giving a better scroll rhythm
          rootMargin: '0px 0px -05% 0px',
          threshold: 0.02
        };

        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              // Add the active class to trigger the CSS transition
              entry.target.classList.add('active');
              
              // Only animate once when scrolling down
              observer.unobserve(entry.target);
            }
          });
        }, revealOptions);

        // Select all elements with the .reveal class and observe them
        document.querySelectorAll('.reveal').forEach((el) => {
          revealObserver.observe(el);
        });

      });
    </script>
  </body>
</html>

<style is:global>
  /* --- PREMIUM REVEAL EFFECT --- */
  .reveal {
    opacity: 0;
    /* Starts slightly lower and with a soft blur */
    transform: translateY(10px);
    filter: blur(2px);
    /* This cubic-bezier curve is the key: starts fast and decelerates veeery smoothly at the end */
    transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    /* Browser optimization to prevent lag during the animation */
    will-change: opacity, transform, filter;
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
</style>
