---
import "../styles/global.css";
import Spotlights from "../components/Spotlights.astro";
import CustomCursor from "../components/CustomCursor.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

// Navigation link definitions
const navLinks = [
  { name: "HOME", url: "#", active: true },
  { name: "ABOUT", url: "#about", active: false },
  { name: "TECH", url: "#tech", active: false },
  { name: "PROJECTS", url: "#projects", active: false },
  { name: "EDUCATION", url: "#education", active: false },
  { name: "CAREER", url: "#career", active: false },
  { name: "CONTACT", url: "#contact", active: false },
];
---

<html lang="en" class="scroll-smooth scroll-pt-14 lg:scroll-pt-16">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=JetBrains+Mono:wght@100..800&family=Space+Grotesk:wght@300..700&family=Permanent+Marker&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body
    class="selection:bg-white/20 selection:text-white bg-black min-h-screen relative overflow-x-hidden"
  >
    <Spotlights />

    <CustomCursor />

    <input
      type="checkbox"
      id="nav-toggle"
      class="fixed opacity-0 w-px h-px pointer-events-none peer"
    />

    <nav
      class="fixed top-0 left-0 right-0 z-50 flex items-center px-5 lg:px-12
             h-14 lg:h-16
             bg-black/60 backdrop-blur-md border-b border-white/25
             pointer-events-none"
    >
      <a
        href="#"
        class="relative z-10 text-3xl md:text-2xl text-gray-200 hover:text-white transition-colors tracking-widest -mt-2 pointer-events-auto"
        style="font-family: 'Permanent Marker', cursive;"
      >
        JAGARDEV
      </a>

      <label
        for="nav-toggle"
        class="xl:hidden ml-auto pointer-events-auto cursor-pointer text-gray-400 hover:text-white transition-colors"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>

      <div
        class="pointer-events-auto hidden xl:flex items-center gap-8 xl:gap-16 absolute left-1/2 -translate-x-1/2 w-max"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.url}
              data-localization={`nav.${link.url.replace("#", "") || "home"}`}
              class="nav-link desktop-link text-[20px] font-script font-extrabold tracking-[0.2em] uppercase transition-colors duration-300 text-gray-500 hover:text-gray-200"
            >
              {link.name}
            </a>
          ))
        }
      </div>

      <!-- Language toggle: desktop -->
      <button
        id="lang-toggle-desktop"
        class="hidden xl:flex items-center gap-2 absolute right-[20%] pointer-events-auto font-mono text-[18px] font-bold tracking-widest cursor-pointer transition-opacity duration-300 hover:opacity-80"
      >
        <span class="lang-en text-white transition-colors duration-300">EN</span
        >
        <span class="text-gray-600">/</span>
        <span class="lang-es text-gray-500 transition-colors duration-300"
          >ES</span
        >
      </button>
    </nav>

    <div
      class="xl:hidden fixed inset-0 z-[60] bg-black/95 backdrop-blur-sm
             flex flex-col items-center justify-center gap-10
             opacity-0 pointer-events-none
             peer-checked:opacity-100 peer-checked:pointer-events-auto
             transition-opacity duration-300"
    >
      <label
        for="nav-toggle"
        class="absolute top-5 right-5 cursor-pointer text-gray-400 hover:text-white transition-colors"
      >
        <svg
          class="w-7 h-7"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </label>

      <a
        href="#"
        class="absolute top-4 left-5 text-2xl text-gray-200 tracking-widest"
        style="font-family: 'Permanent Marker', cursive;"
      >
        JAGARDEV
      </a>

      {
        navLinks.map((link) => (
          <a
            href={link.url}
            data-localization={`nav.${link.url.replace("#", "") || "home"}`}
            class="nav-link mobile-link text-2xl font-script font-extrabold tracking-[0.2em] uppercase transition-colors duration-300 cursor-pointer text-gray-400 hover:text-white"
          >
            {link.name}
          </a>
        ))
      }

      <!-- Language toggle: mobile -->
      <button
        id="lang-toggle-mobile"
        class="mt-10 flex items-center gap-2.5 font-mono text-xl tracking-widest cursor-pointer"
      >
        <span class="lang-en text-white transition-colors duration-300">EN</span
        >
        <span class="text-gray-600">/</span>
        <span class="lang-es text-gray-500 transition-colors duration-300"
          >ES</span
        >
      </button>
    </div>

    <main
      class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 pt-20 xl:pt-52 pb-16 xl:pb-20 flex flex-col gap-16 xl:gap-32"
    >
      <slot />
    </main>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Navigation: track the currently active section via scroll position
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll(".nav-link");
        const mobileLinks = document.querySelectorAll(".mobile-link");
        const navToggle = document.getElementById(
          "nav-toggle",
        ) as HTMLInputElement;

        // Dismiss mobile menu when a link is tapped
        mobileLinks.forEach((link) => {
          link.addEventListener("click", () => {
            if (navToggle) navToggle.checked = false;
          });
        });

        const NAVBAR_OFFSET = 120; // Vertical offset (px) below viewport top to identify the active section

        const updateActiveLink = () => {
          let activeId = "home"; // Default to home when scrolled to the top

          sections.forEach((section) => {
            const id = section.getAttribute("id");
            if (!id) return;
            const rect = section.getBoundingClientRect();
            // A section is considered active when its top edge crosses the offset
            if (rect.top <= NAVBAR_OFFSET) {
              activeId = id;
            }
          });

          navLinks.forEach((link) => {
            // Clear active state
            link.classList.remove("text-white");

            // Restore default inactive color based on link variant
            if (link.classList.contains("desktop-link")) {
              link.classList.add("text-gray-500");
            } else if (link.classList.contains("mobile-link")) {
              link.classList.add("text-gray-400");
            }

            // Highlight the matching navigation link
            const href = link.getAttribute("href");
            if (
              href === `#${activeId}` ||
              (activeId === "home" && (href === "#" || href === "#home"))
            ) {
              link.classList.add("text-white");
              link.classList.remove("text-gray-500", "text-gray-400");
            }
          });
        };

        // Throttle scroll handler to run at most once per animation frame
        let ticking = false;
        window.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(() => {
                updateActiveLink();
                ticking = false;
              });
            }
          },
          { passive: true },
        );

        // Set the correct initial active state on page load
        updateActiveLink();

        // Scroll-triggered reveal animation via Intersection Observer
        const revealOptions = {
          root: null,
          // Negative bottom margin delays triggering until the element
          // is 5% into the viewport, providing a natural scroll rhythm
          rootMargin: "0px 0px -05% 0px",
          threshold: 0.02,
        };

        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // Apply the active class to trigger the CSS transition
              entry.target.classList.add("active");

              // Animate only once per element
              observer.unobserve(entry.target);
            }
          });
        }, revealOptions);

        // Observe all elements marked with the .reveal class
        document.querySelectorAll(".reveal").forEach((el) => {
          revealObserver.observe(el);
        });
      });
    </script>

    <!-- Localization: apply saved language and bind toggle buttons -->
    <script>
      import { translations, getLang, setLang } from "../localization";
      import type { Lang } from "../localization";

      function applyTranslations(): void {
        const lang = getLang();

        document.documentElement.lang = lang;

        const title = translations[lang]?.["page.title"];
        if (title && typeof title === "string") document.title = title;

        // Update text-only elements
        document
          .querySelectorAll<HTMLElement>("[data-localization]")
          .forEach((el) => {
            const key = el.getAttribute("data-localization");
            if (!key) return;
            const val = translations[lang]?.[key] ?? translations.en[key];
            if (val && typeof val === "string") el.textContent = val;
          });

        // Update HTML-content elements (styled spans, etc.)
        document
          .querySelectorAll<HTMLElement>("[data-localization-html]")
          .forEach((el) => {
            const key = el.getAttribute("data-localization-html");
            if (!key) return;
            const val = translations[lang]?.[key] ?? translations.en[key];
            if (val && typeof val === "string") el.innerHTML = val;
          });

        // Update typewriter word arrays
        document
          .querySelectorAll<HTMLElement>("[data-localization-words]")
          .forEach((el) => {
            const key = el.getAttribute("data-localization-words");
            if (!key) return;
            const val = translations[lang]?.[key] ?? translations.en[key];
            if (val && Array.isArray(val)) {
              el.setAttribute("data-words", JSON.stringify(val));
            }
          });

        // Toggle button active states
        document.querySelectorAll<HTMLElement>(".lang-en").forEach((el) => {
          el.classList.toggle("text-white", lang === "en");
          el.classList.toggle("text-gray-500", lang !== "en");
        });
        document.querySelectorAll<HTMLElement>(".lang-es").forEach((el) => {
          el.classList.toggle("text-white", lang === "es");
          el.classList.toggle("text-gray-500", lang !== "es");
        });

        // Notify dynamic components (Typewriter)
        document.dispatchEvent(
          new CustomEvent("lang-change", { detail: { lang } }),
        );
      }

      function toggleLang(): void {
        const next: Lang = getLang() === "en" ? "es" : "en";
        setLang(next);
        applyTranslations();
      }

      document.addEventListener("DOMContentLoaded", () => {
        applyTranslations();
        document
          .getElementById("lang-toggle-desktop")
          ?.addEventListener("click", toggleLang);
        document
          .getElementById("lang-toggle-mobile")
          ?.addEventListener("click", toggleLang);
      });
    </script>
  </body>
</html>

<style is:global>
  /* Scroll-triggered reveal effect: elements fade up and de-blur on entry */
  .reveal {
    opacity: 0;
    /* Initial state: slightly offset downward with a soft blur */
    transform: translateY(10px);
    filter: blur(2px);
    /* Deceleration curve: starts fast and eases out smoothly */
    transition:
      opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
      filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    /* Promote properties to the compositor to prevent animation jank */
    will-change: opacity, transform, filter;
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
</style>
