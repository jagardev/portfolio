---
// src/layouts/Layout.astro
import "../styles/global.css";
import Spotlights from "../components/Spotlights.astro";
import CustomCursor from "../components/CustomCursor.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

// Nav items
const navLinks = [
  { name: "HOME", url: "#", active: true },
  { name: "ABOUT", url: "#about", active: false },
  { name: "TECH", url: "#tech", active: false },
  { name: "PROJECTS", url: "#projects", active: false },
  { name: "EDUCATION", url: "#education", active: false },
  { name: "CAREER", url: "#career", active: false },
  { name: "CONTACT", url: "#contact", active: false },
];
---

<!-- Scroll attributes to position correctly when clicking link menus or scrolling -->
<html lang="en" class="scroll-smooth scroll-pt-14 lg:scroll-pt-16">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <!-- Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=JetBrains+Mono:wght@100..800&family=Space+Grotesk:wght@300..700&family=Permanent+Marker&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="selection:bg-white/20 selection:text-white bg-black min-h-screen relative overflow-x-hidden"
  >
    <!-- Render the custom spotlights here -->
    <Spotlights />

    <!-- CustomCursor -->
    <CustomCursor />

    <!-- Mobile nav toggle: checkbox trick -->
    <input
      type="checkbox"
      id="nav-toggle"
      class="fixed opacity-0 w-px h-px pointer-events-none peer"
    />

    <!-- Navbar -->
    <nav
      class="fixed top-0 left-0 right-0 z-50 flex items-center px-5 lg:px-12
             h-14 lg:h-16
             bg-black/60 backdrop-blur-md border-b border-white/25
             pointer-events-none"
    >
      <!-- Logo -->
      <a
        href="#"
        class="relative z-10 text-3xl md:text-2xl text-gray-200 hover:text-white transition-colors tracking-widest -mt-2 pointer-events-auto"
        style="font-family: 'Permanent Marker', cursive;"
      >
        JAGARDEV
      </a>

      <!-- Hamburger button (mobile) -->
      <label
        for="nav-toggle"
        class="xl:hidden ml-auto pointer-events-auto cursor-pointer text-gray-400 hover:text-white transition-colors"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>

      <!-- Center bar -->
      <!-- Perfect mathematical centering using: absolute left-1/2 -translate-x-1/2 -->
      <div
        class="pointer-events-auto hidden xl:flex items-center gap-8 xl:gap-16 absolute left-1/2 -translate-x-1/2 w-max"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.url}
              class="nav-link desktop-link text-[20px] font-script font-extrabold tracking-[0.2em] uppercase transition-colors duration-300 text-gray-500 hover:text-gray-200"
            >
              {link.name}
            </a>
          ))
        }
      </div>
    </nav>

    <!-- Overlay fullscreen (mobile) -->
    <div
      class="xl:hidden fixed inset-0 z-[60] bg-black/95 backdrop-blur-sm
             flex flex-col items-center justify-center gap-10
             opacity-0 pointer-events-none
             peer-checked:opacity-100 peer-checked:pointer-events-auto
             transition-opacity duration-300"
    >
      <!-- X button to close menu-->
      <label
        for="nav-toggle"
        class="absolute top-5 right-5 cursor-pointer text-gray-400 hover:text-white transition-colors"
      >
        <svg
          class="w-7 h-7"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </label>

      <!-- Logo inside overlay -->
      <a
        href="#"
        class="absolute top-4 left-5 text-2xl text-gray-200 tracking-widest"
        style="font-family: 'Permanent Marker', cursive;"
      >
        JAGARDEV
      </a>

      <!-- Links -->
      {
        navLinks.map((link) => (
          <a
            href={link.url}
            class="nav-link mobile-link text-2xl font-script font-extrabold tracking-[0.2em] uppercase transition-colors duration-300 cursor-pointer text-gray-400 hover:text-white"
          >
            {link.name}
          </a>
        ))
      }
    </div>

    <!-- Main wrapper -->
    <main
      class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 pt-20 xl:pt-52 pb-16 xl:pb-20 flex flex-col gap-16 xl:gap-32"
    >
      <slot />
    </main>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Target all sections with an ID and all navigation links
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll(".nav-link");
        const mobileLinks = document.querySelectorAll(".mobile-link");
        const navToggle = document.getElementById(
          "nav-toggle",
        ) as HTMLInputElement;

        // --- Close mobile menu on click ---
        mobileLinks.forEach((link) => {
          link.addEventListener("click", () => {
            if (navToggle) navToggle.checked = false;
          });
        });

        // --- Active section tracking ---
        // Uses a scroll listener instead of IntersectionObserver because IO
        // has boundary edge-cases with the fixed navbar height that cause
        // sections (especially #home) to be missed.
        //
        // Logic: iterate sections in DOM order (top-to-bottom). The last
        // section whose top edge has scrolled past the navbar is the
        // "current" one. If none have passed, default to "home".
        const NAVBAR_OFFSET = 120; // px below viewport top to count as "entered"

        const updateActiveLink = () => {
          let activeId = "home"; // default when at the very top

          sections.forEach((section) => {
            const id = section.getAttribute("id");
            if (!id) return;
            const rect = section.getBoundingClientRect();
            // Section is "current" when its top has scrolled above the offset
            if (rect.top <= NAVBAR_OFFSET) {
              activeId = id;
            }
          });

          navLinks.forEach((link) => {
            // Remove active state
            link.classList.remove("text-white");

            // Restore default inactive colors per link type
            if (link.classList.contains("desktop-link")) {
              link.classList.add("text-gray-500");
            } else if (link.classList.contains("mobile-link")) {
              link.classList.add("text-gray-400");
            }

            // Apply active state to the matching link
            const href = link.getAttribute("href");
            if (
              href === `#${activeId}` ||
              (activeId === "home" && (href === "#" || href === "#home"))
            ) {
              link.classList.add("text-white");
              link.classList.remove("text-gray-500", "text-gray-400");
            }
          });
        };

        // Throttle with rAF so we run at most once per frame
        let ticking = false;
        window.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(() => {
                updateActiveLink();
                ticking = false;
              });
            }
          },
          { passive: true },
        );

        // Set correct initial state on load (handles F5 at any scroll position)
        updateActiveLink();
      });
    </script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const observerOptions = {
          root: null,
          rootMargin: "0px",
          threshold: 0.15, // Activation at 15% visibility of the next element
        };

        const observer = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("active");
              // Not repetition when scrolling back up
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        // Selects all elements with the class 'reveal'
        const revealElements = document.querySelectorAll(".reveal");
        revealElements.forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>

<style is:global>
  /* Scroll animation */
  .reveal {
    opacity: 0;
    transform: translateY(5px);
    /* Use explicit properties instead of `all` to avoid triggering
       layout/paint recalculations on every child element (e.g. carousel images) */
    transition: opacity 0.2s cubic-bezier(0.5, 0, 0, 1),
                transform 0.2s cubic-bezier(0.5, 0, 0, 1);
    /* Promote to its own compositor layer to keep animations on the GPU */
    will-change: opacity, transform;
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }
</style>
