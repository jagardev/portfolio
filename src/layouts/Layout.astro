---
import "../styles/global.css";
import Spotlights from "../components/Spotlights.astro";
import CustomCursor from "../components/CustomCursor.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

// Navigation link definitions
const navLinks = [
  { name: "HOME", url: "#", active: true },
  { name: "ABOUT", url: "#about", active: false },
  { name: "TECH", url: "#tech", active: false },
  { name: "PROJECTS", url: "#projects", active: false },
  { name: "EDUCATION", url: "#education", active: false },
  { name: "CAREER", url: "#career", active: false },
  { name: "CONTACT", url: "#contact", active: false },
];
---

<html lang="en" class="scroll-smooth scroll-pt-14 lg:scroll-pt-16 bg-black text-gray-400">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark only" />
    <meta name="description" content="Jairo Garcia Antolin - Software & AI Developer. I design scalable systems and build modern software solutions." />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body
    class="selection:bg-white/20 selection:text-white bg-black min-h-screen relative overflow-x-hidden"
  >
    <Spotlights />

    <CustomCursor />

    <input
      type="checkbox"
      id="nav-toggle"
      aria-label="Toggle navigation"
      class="fixed opacity-0 w-px h-px pointer-events-none peer"
    />

    <nav
      class="fixed top-0 left-0 right-0 z-50 flex xl:grid xl:grid-cols-[1fr_auto_1fr] items-center px-5 lg:px-12
             h-14 lg:h-16
             bg-black/60 backdrop-blur-md border-b border-white/25
             pointer-events-none"
    >
      <a
        href="#"
        class="relative z-10 text-3xl md:text-2xl text-gray-200 hover:text-white transition-colors tracking-widest -mt-2 pointer-events-auto justify-self-start"
        style="font-family: 'Permanent Marker', cursive;"
      >
        JAGARDEV
      </a>

      <label
        for="nav-toggle"
        class="xl:hidden ml-auto pointer-events-auto cursor-pointer text-gray-400 hover:text-white transition-colors"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>

      <div
        class="pointer-events-auto hidden xl:flex items-center justify-center gap-8 xl:gap-16 w-max"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.url}
              data-localization={`nav.${link.url.replace("#", "") || "home"}`}
              class="nav-link desktop-link text-[20px] font-script font-extrabold tracking-[0.2em] uppercase transition-colors duration-300 text-gray-400 hover:text-gray-200"
            >
              {link.name}
            </a>
          ))
        }
      </div>

      <!-- Language toggle: desktop -->
      <div
        id="lang-toggle-desktop"
        class="hidden xl:flex justify-self-center items-center gap-2 pointer-events-auto font-mono text-[18px] font-bold tracking-widest transition-opacity duration-300"
      >
        <button class="lang-en text-white transition-colors duration-300 hover:opacity-80 cursor-pointer">EN</button>
        <span class="text-gray-600">/</span>
        <button class="lang-es text-gray-400 transition-colors duration-300 hover:opacity-80 cursor-pointer"
          >ES</button>
      </div>
    </nav>

    <div
      class="xl:hidden fixed inset-0 z-[60] bg-black/95 backdrop-blur-sm
             flex flex-col items-center justify-center gap-10
             opacity-0 pointer-events-none
             peer-checked:opacity-100 peer-checked:pointer-events-auto
             transition-opacity duration-300"
    >
      <label
        for="nav-toggle"
        class="absolute top-5 right-5 cursor-pointer text-gray-400 hover:text-white transition-colors"
      >
        <svg
          class="w-7 h-7"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </label>

      <a
        href="#"
        class="absolute top-4 left-5 text-2xl text-gray-200 tracking-widest"
        style="font-family: 'Permanent Marker', cursive;"
      >
        JAGARDEV
      </a>

      {
        navLinks.map((link) => (
          <a
            href={link.url}
            data-localization={`nav.${link.url.replace("#", "") || "home"}`}
            class="nav-link mobile-link text-2xl font-script font-extrabold tracking-[0.2em] uppercase transition-colors duration-300 cursor-pointer text-gray-400 hover:text-white"
          >
            {link.name}
          </a>
        ))
      }

      <!-- Language toggle: mobile -->
      <div
        id="lang-toggle-mobile"
        class="mt-10 flex items-center gap-2.5 font-mono text-xl tracking-widest"
      >
        <button class="lang-en text-white transition-colors duration-300 cursor-pointer">EN</button>
        <span class="text-gray-600">/</span>
        <button class="lang-es text-gray-400 transition-colors duration-300 cursor-pointer"
          >ES</button>
      </div>
    </div>

    <main
      class="relative z-10 max-w-7xl mx-auto px-5 md:px-12 pt-20 xl:pt-52 pb-16 xl:pb-20 flex flex-col gap-16 xl:gap-32"
    >
      <slot />
    </main>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Navigation: track the currently active section via scroll position
        const sections = document.querySelectorAll("section[id]");
        const navLinks = document.querySelectorAll(".nav-link");
        const mobileLinks = document.querySelectorAll(".mobile-link");
        const navToggle = document.getElementById(
          "nav-toggle",
        ) as HTMLInputElement;

        // Dismiss mobile menu when a link is tapped
        mobileLinks.forEach((link) => {
          link.addEventListener("click", () => {
            if (navToggle) navToggle.checked = false;
          });
        });

        const updateActiveLink = (activeId) => {
          navLinks.forEach((link) => {
            // Clear active state
            link.classList.remove("text-white");

            // Restore default inactive color
            link.classList.add("text-gray-400");

            // Highlight the matching navigation link
            const href = link.getAttribute("href");
            if (
              href === `#${activeId}` ||
              (activeId === "home" && (href === "#" || href === "#home"))
            ) {
              link.classList.add("text-white");
              link.classList.remove("text-gray-400");
            }
          });
        };

        const sectionObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute("id");
                if (id) updateActiveLink(id);
              }
            });
          },
          { rootMargin: "-120px 0px -80% 0px", threshold: 0 }
        );

        sections.forEach((section) => {
          sectionObserver.observe(section);
        });

        // Fallback for absolute top of the page
        window.addEventListener("scroll", () => {
          if (window.scrollY < 50) updateActiveLink("home");
        }, { passive: true });

        // Scroll-triggered reveal animation via Intersection Observer
        const revealOptions = {
          root: null,
          // Negative bottom margin delays triggering until the element
          // is 5% into the viewport, providing a natural scroll rhythm
          rootMargin: "0px 0px -05% 0px",
          threshold: 0.02,
        };

        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // Apply the active class to trigger the CSS transition
              entry.target.classList.add("active");

              // Animate only once per element
              observer.unobserve(entry.target);
            }
          });
        }, revealOptions);

        // Observe all elements marked with the .reveal class
        document.querySelectorAll(".reveal").forEach((el) => {
          revealObserver.observe(el);
        });
      });
    </script>

    <!-- Localization: apply saved language and bind toggle buttons -->
    <script>
      // Inline getLang() to avoid importing the 23KB localization module on initial load.
      // This eliminates the JS waterfall: Layout.astro.js → localization.js
      function getStoredLang(): "en" | "es" {
        let saved: string | null = null;
        try { saved = localStorage.getItem("lang"); } catch(e) { /* ignore */ }
        if (saved === "en" || saved === "es") return saved;
        try {
          const bl = navigator.language || "";
          if (bl.toLowerCase().startsWith("es")) return "es";
        } catch(e) { /* ignore */ }
        return "en";
      }

      // Lazily load the full localization module and apply translations
      async function loadAndApply() {
        const { translations, getLang, setLang } = await import("../localization");

        function applyTranslations(): void {
          const lang = getLang();
          document.documentElement.lang = lang;

          const title = translations[lang]?.["page.title"];
          if (title && typeof title === "string") document.title = title;

          document
            .querySelectorAll<HTMLElement>("[data-localization]")
            .forEach((el) => {
              const key = el.getAttribute("data-localization");
              if (!key) return;
              const val = translations[lang]?.[key] ?? translations.en[key];
              if (val && typeof val === "string" && el.textContent !== val) {
                el.textContent = val;
              }
            });

          document
            .querySelectorAll<HTMLElement>("[data-localization-html]")
            .forEach((el) => {
              const key = el.getAttribute("data-localization-html");
              if (!key) return;
              const val = translations[lang]?.[key] ?? translations.en[key];
              if (val && typeof val === "string" && el.innerHTML !== val) {
                el.innerHTML = val;
              }
            });

          document
            .querySelectorAll<HTMLElement>("[data-localization-words]")
            .forEach((el) => {
              const key = el.getAttribute("data-localization-words");
              if (!key) return;
              const val = translations[lang]?.[key] ?? translations.en[key];
              if (val && Array.isArray(val)) {
                el.setAttribute("data-words", JSON.stringify(val));
              }
            });

          document.querySelectorAll<HTMLElement>(".lang-en").forEach((el) => {
            el.classList.toggle("text-white", lang === "en");
            el.classList.toggle("text-gray-400", lang !== "en");
          });
          document.querySelectorAll<HTMLElement>(".lang-es").forEach((el) => {
            el.classList.toggle("text-white", lang === "es");
            el.classList.toggle("text-gray-400", lang !== "es");
          });

          document.dispatchEvent(
            new CustomEvent("lang-change", { detail: { lang } }),
          );
        }

        // Apply immediately after loading
        applyTranslations();

        // Bind toggle buttons with the now-loaded module
        document
          .querySelectorAll(".lang-en")
          .forEach((el) => el.addEventListener("click", () => {
            setLang("en");
            applyTranslations();
          }));
        document
          .querySelectorAll(".lang-es")
          .forEach((el) => el.addEventListener("click", () => {
            setLang("es");
            applyTranslations();
          }));
      }

      document.addEventListener("DOMContentLoaded", () => {
        const lang = getStoredLang();
        if (lang !== "en") {
          // Spanish user: load localization immediately to translate the page
          loadAndApply();
        } else {
          // English user: defer loading until a language toggle is clicked
          const bindLazy = (selector: string) => {
            document.querySelectorAll(selector).forEach((el) => {
              el.addEventListener("click", () => loadAndApply(), { once: true });
            });
          };
          bindLazy(".lang-en");
          bindLazy(".lang-es");
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* Scroll-triggered reveal effect: elements fade up and de-blur on entry */
  .reveal {
    opacity: 0;
    /* Initial state: slightly offset downward with a soft blur */
    transform: translateY(10px);
    filter: blur(2px);
    /* Deceleration curve: starts fast and eases out smoothly */
    transition:
      opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
      filter 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    /* Promote properties to the compositor to prevent animation jank */
    will-change: opacity, transform, filter;
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
</style>
