---
import Divider from "./Divider.astro";

// Professional experience entries displayed on the timeline
const careerItems = [
  {
    year: "03/2026 - 07/2026",
    title: "Software Developer Internship",
    institution: "Data Control SL | 4 months",
    description: "Data manipulation using DataFlex and SQL. Building and maintaining databases, dashboards and moodle platforms."
  },
  {
    year: "01/2024 - 03/2026",
    title: "Independence Compliance & Operations Specialist",
    institution: "PricewaterhouseCoopers Service Delivery Center (Málaga) SL | 2 years 2 months",
    description: "Company compliance and independence management for the multinational big four company PwC."
  },
  {
    year: "05/2022 - 12/2022",
    title: "Banking Dispute Resolution Specialist",
    institution: "OPPLUS SL - Malaga | 8 months",
    description: "Customer service and resolution of disputes in the banking sector."
  },
  {
    year: "07/2021 - 12/2021",
    title: "Photovoltaic Sales Operations Administrator",
    institution: "Instalaciones Smart Spain SL - Palencia | 6 months",
    description: "Coordination of contracts, public relationships, and sales processes."
  },
  {
    year: "01/2021 - 07/2021",
    title: "Energy Sales Backoffice Administrator",
    institution: "Oregon Comercial SL - Palencia | 7 months",
    description: "Management and optimization of sales and customer relations processes."
  }
];
---

<section id="career" class="w-full">
  <Divider class="mb-16 xl:mb-24" />
  
  <div class="flex flex-col gap-12 max-w-7xl mx-auto w-full px-4 md:px-0 reveal">
    
    <!-- Section Header -->
    <div class="flex flex-col gap-2">
      <h2 class="text-5xl md:text-7xl font-sans font-light text-gray-100 tracking-tight flex flex-wrap items-center gap-3">
        <!-- Briefcase icon -->
        <svg class="w-10 h-10 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>  
        <span data-localization="career.title.main">Career </span><span class="font-script text-gray-400 lowercase text-6xl md:text-8xl align-middle pr-4" data-localization="career.title.accent">trajectory</span>
      </h2>
      <p class="font-mono text-gray-400 text-[18px] uppercase tracking-widest mt-2" data-localization="career.subtitle">This is just the beginning</p>
    </div>

    <!-- Timeline layout with vertical connector line -->
    <!-- Left margin offsets the line slightly from the screen edge on mobile -->
    <div class="relative ml-2 md:ml-10 mt-6">
      
      <!-- Vertical connector line stretching the full height of the entries -->
      <div class="absolute left-[7px] top-2 bottom-2 w-px bg-white/20"></div>

      <!-- Career entry list -->
      <div class="flex flex-col gap-10">
        {careerItems.map((item, index) => (
          // The group class enables coordinated hover styling on the dot and text
          <div class="relative pl-10 md:pl-12 group">
            
            {/* The Dot */}
            {/* 
                Timeline dot positioned on the vertical line.
                Hover state applies glow and fill via the group utility.
            */}
            <div class="absolute left-0 top-1.5 w-4 h-4 rounded-full bg-[#050505] border-2 border-gray-600 group-hover:border-white group-hover:shadow-[0_0_15px_rgba(255,255,255,0.8)] group-hover:bg-white transition-all duration-300 z-10"></div>
            
            {/* Entry content */}
            <div class="flex flex-col gap-1.5 cursor-default">
              {/* Date range badge */}
              <span class="font-mono text-[13px] font-semibold text-gray-100/90 uppercase tracking-widest bg-gray-400/10 border border-gray-100/50 px-2 py-0.5 rounded-full w-max" data-localization={`career.${index}.year`}>
                {item.year}
              </span>
              
              {/* Role title and organization */}
              <h3 class="font-sans text-2xl md:text-3xl text-gray-200 font-medium mt-1 group-hover:text-white transition-colors duration-300" data-localization={`career.${index}.title`}>
                {item.title}
              </h3>
              <h4 class="font-sans text-[16px] md:text-[18px] text-gray-400 italic" data-localization={`career.${index}.institution`}>
                {item.institution}
              </h4>
              
              {/* Role description */}
              <p class="font-mono text-gray-350 md:text-[18px] text-[18px] leading-relaxed mt-2 max-w-2xl group-hover:text-gray-200 transition-colors duration-300" data-localization={`career.${index}.description`}>
                {item.description}
              </p>
            </div>
            
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
