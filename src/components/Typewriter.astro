---
interface Props {
  words: string[];
  class?: string;
  showCursor?: boolean;
  langKey?: string;
}

// Destructure props: array of phrases, optional CSS class, cursor visibility flag, and localization key
const {
  words,
  class: className = "",
  showCursor = true,
  langKey,
} = Astro.props;
---

<!--
  Custom HTML element (<type-writer>) isolates the script scope.
  The phrases array is passed as a JSON-encoded data attribute.
-->
<type-writer
  data-words={JSON.stringify(words)}
  {...langKey ? { "data-localization-words": langKey } : {}}
  class="inline"
>
  <!-- Pre-render the first word to prevent LCP delay caused by empty initial state -->
  <span class={`typed-text ${className}`}>{words.length > 0 ? words[0] : ""}</span>
  {
    showCursor && (
      <span class="md:w-[4px] md:h-[0.8em] w-[3px] h-[0.5em] bg-white md:ml-4 ml-2 inline-block animate-[pulse_0.8s_ease-in-out_infinite]" />
    )
  }
</type-writer>

<script>
  // Custom element behavior for the typewriter effect
  class TypeWriter extends HTMLElement {
    private _timeout: ReturnType<typeof setTimeout> | null = null;
    private _currentWords: string[] = [];

    connectedCallback() {
      this._startTyping();

      // Restart typing when the language changes
      document.addEventListener("lang-change", () => {
        this._handleLangChange();
      });
    }

    private _startTyping() {
      // Parse the phrase list provided by the Astro component
      const words: string[] = JSON.parse(this.dataset.words || "[]");
      this._currentWords = words;
      const textElement = this.querySelector(".typed-text");

      if (!words.length || !textElement) return;

      const currentText = textElement.textContent || "";
      let wordIndex = 0;
      // Start character index based on what is already in the DOM
      let charIndex = currentText.length;
      // If we have text, our next action is deleting it
      let isDeleting = charIndex > 0;

      const type = () => {
        const currentWord = words[wordIndex];
        // Typing speed: 40ms per character; deletion speed: 20ms per character
        const speed = isDeleting ? 20 : 40;

        if (isDeleting) {
          textElement.textContent = currentWord.substring(0, charIndex - 1);
          charIndex--;
        } else {
          textElement.textContent = currentWord.substring(0, charIndex + 1);
          charIndex++;
        }

        // State transitions after completing a word
        if (!isDeleting && charIndex === currentWord.length) {
          // Pause before starting to delete the completed phrase
          isDeleting = true;
          this._timeout = setTimeout(type, 1000);
        } else if (isDeleting && charIndex === 0) {
          // Advance to the next phrase with a brief pause
          isDeleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          this._timeout = setTimeout(type, 500);
        } else {
          // Continue the current typing or deletion cycle
          this._timeout = setTimeout(type, speed);
        }
      };

      // If text is pre-rendered, wait 1000ms before deleting, otherwise start immediately
      if (charIndex > 0) {
        this._timeout = setTimeout(type, 1000);
      } else {
        type();
      }
    }

    private _handleLangChange() {
      const newWords: string[] = JSON.parse(this.dataset.words || "[]");

      // Skip restart if words haven't changed
      if (JSON.stringify(newWords) === JSON.stringify(this._currentWords))
        return;

      // Cancel current animation
      if (this._timeout) {
        clearTimeout(this._timeout);
        this._timeout = null;
      }

      // Clear displayed text and restart with updated words
      const textElement = this.querySelector(".typed-text");
      if (textElement) textElement.textContent = "";

      this._startTyping();
    }
  }

  // Register the custom element in the browser's element registry
  customElements.define("type-writer", TypeWriter);
</script>

<style>
  /* Prevents layout shift when text content is empty */
  .typed-text::before {
    content: "\200b";
  }
</style>
