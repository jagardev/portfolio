---
interface Props {
  words: string[];
  class?: string;
  showCursor?: boolean;
}

// Destructure props: array of phrases, optional CSS class, and cursor visibility flag
const { words, class: className = "", showCursor = true } = Astro.props;
---

<!-- 
  Custom HTML element (<type-writer>) isolates the script scope.
  The phrases array is passed as a JSON-encoded data attribute.
-->
<type-writer
  data-words={JSON.stringify(words)}
  class="inline-flex items-center"
>
  <span class={`typed-text ${className}`}></span>
  {showCursor && (
    <span
      class="md:w-[4px] md:h-[0.8em] w-[3px] h-[0.5em] bg-white md:ml-4 ml-2 inline-block animate-[pulse_0.8s_ease-in-out_infinite]"
    ></span>
  )}
</type-writer>

<script>
  // Custom element behavior for the typewriter effect
  class TypeWriter extends HTMLElement {
    connectedCallback() {
      // Parse the phrase list provided by the Astro component
      const words = JSON.parse(this.dataset.words || "[]");
      const textElement = this.querySelector(".typed-text");

      if (!words.length || !textElement) return;

      let wordIndex = 0;
      let charIndex = 0;
      let isDeleting = false;

      const type = () => {
        const currentWord = words[wordIndex];
        // Typing speed: 40ms per character; deletion speed: 20ms per character
        const speed = isDeleting ? 20 : 40;

        if (isDeleting) {
          textElement.textContent = currentWord.substring(0, charIndex - 1);
          charIndex--;
        } else {
          textElement.textContent = currentWord.substring(0, charIndex + 1);
          charIndex++;
        }

        // State transitions after completing a word
        if (!isDeleting && charIndex === currentWord.length) {
          // Pause before starting to delete the completed phrase
          isDeleting = true;
          setTimeout(type, 1000);
        } else if (isDeleting && charIndex === 1) {
          // Advance to the next phrase with a brief pause
          isDeleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          setTimeout(type, 500);
        } else {
          // Continue the current typing or deletion cycle
          setTimeout(type, speed);
        }
      };

      // Begin the typewriter animation cycle
      type();
    }
  }

  // Register the custom element in the browser's element registry
  customElements.define("type-writer", TypeWriter);
</script>
