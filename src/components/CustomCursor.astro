<!-- Custom glowing cursor dot — only rendered for mouse/trackpad devices (pointer: fine) -->
<div 
  id="cursor-dot" 
  class="fixed top-0 left-0 w-4 h-4 bg-white rounded-full pointer-events-none z-[10000] transform -translate-x-1/2 -translate-y-1/2 shadow-[0_0_15px_rgba(255,255,255,0.99)] opacity-0"
></div>

<style is:global>
  /* Hide the native OS cursor exclusively on devices with a precise pointer and true
     hover support. This combination targets mouse/trackpad devices while excluding
     touch tablets that may report pointer: fine (e.g. stylus) but lack hover. */
  @media (pointer: fine) and (hover: hover) {
    * {
      cursor: none !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Only activate the custom cursor for devices with a precise pointer and hover support.
    // Adding (hover: hover) to (pointer: fine) ensures stylus-only tablets are excluded.
    if (!window.matchMedia("(pointer: fine) and (hover: hover)").matches) return;

    const dot = document.getElementById('cursor-dot');
    // Reveal the cursor dot once pointer device is confirmed
    if (dot) dot.style.opacity = '1';
    let mouseX = 0;
    let mouseY = 0;
    let isActive = false;

    // Track mouse coordinates on every move event
    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      isActive = true;

      // Position the dot directly at the cursor via left/top (avoids conflicting with CSS transform centering)
      if(dot) {
        dot.style.left = `${mouseX}px`;
        dot.style.top = `${mouseY}px`;
      }
    });

    // Click handler: spawn spark particles and pulse the cursor dot
    window.addEventListener('click', (e) => {
      const particleCount = 8;
      for (let i = 0; i < particleCount; i++) {
        createSpark(e.clientX, e.clientY);
      }
      
      // Pulse animation: scale only so the CSS transform centering remains intact
      if(dot) {
        dot.animate([
          { scale: 1 },
          { scale: 0.3 }, // Brief contraction to emphasize the spark burst
          { scale: 1 }
        ], { duration: 250, easing: 'ease-out' });
      }
    });

    // Generate an explosive spark particle at the given coordinates
    function createSpark(x, y) {
      const particle = document.createElement('div');
      particle.className = 'fixed w-1.5 h-1.5 bg-white rounded-full pointer-events-none z-[9999] shadow-[0_0_8px_rgba(255,255,255,0.9)]';
      particle.style.left = `${x}px`;
      particle.style.top = `${y}px`;
      document.body.appendChild(particle);

      const angle = Math.random() * Math.PI * 2;
      const velocity = 20 + Math.random() * 30;
      const tx = Math.cos(angle) * velocity;
      const ty = Math.sin(angle) * velocity;

      const animation = particle.animate([
        { transform: `translate(-50%, -50%) scale(1)`, opacity: 1 },
        { transform: `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(0)`, opacity: 0 }
      ], {
        duration: 300 + Math.random() * 200,
        easing: 'cubic-bezier(0, .9, .57, 1)'
      });

      animation.onfinish = () => particle.remove();
    }

    // Emit ambient dust particles continuously while the cursor is active (every 60ms)
    setInterval(() => {
      if (isActive) {
        createDust(mouseX, mouseY);
      }
    }, 60);

    // Generate a slow-drifting ambient particle near the cursor
    function createDust(x, y) {
      const dust = document.createElement('div');
      // Small glowing dot particle
      dust.className = 'fixed w-[3px] h-[3px] bg-white/70 rounded-full pointer-events-none z-[9998] shadow-[0_0_6px_rgba(255,255,255,0.8)]';
      
      // Offset spawn position slightly from cursor center
      const offsetX = (Math.random() - 0.5) * 30;
      const offsetY = (Math.random() - 0.5) * 30;
      
      dust.style.left = `${x + offsetX}px`;
      dust.style.top = `${y + offsetY}px`;
      
      document.body.appendChild(dust);

      // Random drift direction across full 360 degrees
      const tx = (Math.random() - 0.5) * 50;
      const ty = (Math.random() - 0.5) * 50;

      const animation = dust.animate([
        { transform: 'translate(-50%, -50%) scale(1)', opacity: Math.random() * 0.6 + 0.2 },
        { transform: `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(0)`, opacity: 0 }
      ], {
        duration: 700 + Math.random() * 600, // Longer lifespan than click sparks
        easing: 'ease-out'
      });

      animation.onfinish = () => dust.remove();
    }
  });
</script>