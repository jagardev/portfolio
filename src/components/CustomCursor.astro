---
// src/components/CustomCursor.astro
---

<!-- Single glowing cursor dot (Hidden on mobile, only visible on medium screens and up) -->
<div 
  id="cursor-dot" 
  class="hidden md:block fixed top-0 left-0 w-4 h-4 bg-white rounded-full pointer-events-none z-[10000] transform -translate-x-1/2 -translate-y-1/2 shadow-[0_0_15px_rgba(255,255,255,0.99)]"
></div>

<style is:global>
  /* Hide the default OS cursor ONLY on desktop */
  @media (min-width: 768px) {
    * {
      cursor: none !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Prevent script execution on touch devices (mobiles/tablets)
    if (window.matchMedia("(pointer: coarse)").matches) return;

    const dot = document.getElementById('cursor-dot');
    let mouseX = 0;
    let mouseY = 0;
    let isActive = false;

    // Mouse movement tracking
    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      isActive = true;

      // The dot moves instantly to the cursor position
      // Using left/top avoids interfering with the CSS transform centering
      if(dot) {
        dot.style.left = `${mouseX}px`;
        dot.style.top = `${mouseY}px`;
      }
    });

    // Click spark particle effect & dot pulse
    window.addEventListener('click', (e) => {
      const particleCount = 8; // Number of explosion sparks
      for (let i = 0; i < particleCount; i++) {
        createSpark(e.clientX, e.clientY);
      }
      
      // Fixed pulse: animate ONLY the scale property so it doesn't break the CSS transform centering
      if(dot) {
        dot.animate([
          { scale: 1 },
          { scale: 0.3 }, // Shrinks tightly to let sparks shine
          { scale: 1 }
        ], { duration: 250, easing: 'ease-out' });
      }
    });

    // Function to generate the fast click explosion sparks
    function createSpark(x, y) {
      const particle = document.createElement('div');
      particle.className = 'fixed w-1.5 h-1.5 bg-white rounded-full pointer-events-none z-[9999] shadow-[0_0_8px_rgba(255,255,255,0.9)]';
      particle.style.left = `${x}px`;
      particle.style.top = `${y}px`;
      document.body.appendChild(particle);

      const angle = Math.random() * Math.PI * 2;
      const velocity = 20 + Math.random() * 30;
      const tx = Math.cos(angle) * velocity;
      const ty = Math.sin(angle) * velocity;

      const animation = particle.animate([
        { transform: `translate(-50%, -50%) scale(1)`, opacity: 1 },
        { transform: `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(0)`, opacity: 0 }
      ], {
        duration: 300 + Math.random() * 200,
        easing: 'cubic-bezier(0, .9, .57, 1)'
      });

      animation.onfinish = () => particle.remove();
    }

    // Continuous magic dust trail (emits every 60ms)
    setInterval(() => {
      if (isActive) {
        createDust(mouseX, mouseY);
      }
    }, 60);

    // Function to generate slow, floating background particles
    function createDust(x, y) {
      const dust = document.createElement('div');
      // Tiny glowing dots
      dust.className = 'fixed w-[3px] h-[3px] bg-white/70 rounded-full pointer-events-none z-[9998] shadow-[0_0_6px_rgba(255,255,255,0.8)]';
      
      // Spawn slightly offset from the exact center of the cursor
      const offsetX = (Math.random() - 0.5) * 30;
      const offsetY = (Math.random() - 0.5) * 30;
      
      dust.style.left = `${x + offsetX}px`;
      dust.style.top = `${y + offsetY}px`;
      
      document.body.appendChild(dust);

      // Drift physics: floats randomly in ALL directions (360 degrees)
      const tx = (Math.random() - 0.5) * 50;
      const ty = (Math.random() - 0.5) * 50;

      const animation = dust.animate([
        { transform: 'translate(-50%, -50%) scale(1)', opacity: Math.random() * 0.6 + 0.2 },
        { transform: `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(0)`, opacity: 0 }
      ], {
        duration: 700 + Math.random() * 600, // Lingers longer than click sparks
        easing: 'ease-out'
      });

      animation.onfinish = () => dust.remove();
    }
  });
</script>