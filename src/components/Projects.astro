---
// src/components/Projects.astro
import Divider from "./Divider.astro";

const projects = [
  {
    title: "Data Winds",
    description: "A robust data validation tool and professional portfolio platform. Built to process complex datasets while presenting a clean, intuitive, and responsive user interface.",
    tags: ["FastAPI", "React", "PostgreSQL", "Docker"],
    // Placeholder gradient using your Black, White, and Gold scheme
    imagePlaceholder: "bg-gradient-to-br from-[#1a1a1a] via-[#050505] to-[#c5a059]/20",
    liveLink: "#",
    repoLink: "#"
  },
  {
    title: "Fantasy Stats Analyzer",
    description: "An analytical engine designed to optimize fantasy sports rosters. It scrapes and aggregates player performance metrics and scoring systems to provide real-time market valuations.",
    tags: ["Python", "Astro", "Tailwind CSS"],
    // Placeholder gradient with a subtle green/blue analytical vibe
    imagePlaceholder: "bg-gradient-to-bl from-[#050505] via-[#0a192f] to-[#10b981]/10",
    liveLink: "#",
    repoLink: "#"
  },
  {
    title: "Fantasy Stats Analyzer",
    description: "An analytical engine designed to optimize fantasy sports rosters. It scrapes and aggregates player performance metrics and scoring systems to provide real-time market valuations.",
    tags: ["Python", "Astro", "Tailwind CSS"],
    // Placeholder gradient with a subtle green/blue analytical vibe
    imagePlaceholder: "bg-gradient-to-bl from-[#050505] via-[#0a192f] to-[#10b981]/10",
    liveLink: "#",
    repoLink: "#"
  },
  {
    title: "Fantasy Stats Analyzer",
    description: "An analytical engine designed to optimize fantasy sports rosters. It scrapes and aggregates player performance metrics and scoring systems to provide real-time market valuations.",
    tags: ["Python", "Astro", "Tailwind CSS"],
    // Placeholder gradient with a subtle green/blue analytical vibe
    imagePlaceholder: "bg-gradient-to-bl from-[#050505] via-[#0a192f] to-[#10b981]/10",
    liveLink: "#",
    repoLink: "#"
  }
];
---

<section id="projects" class="w-full">
  <Divider class="mb-16 xl:mb-24" />
  <div class="flex flex-col gap-12 max-w-7xl mx-auto w-full px-4 md:px-0 reveal">
    
    <!-- Section Header -->
    <div class="flex flex-col gap-2 w-full">
      <h2 class="text-5xl md:text-7xl font-sans font-light text-gray-100 tracking-tight flex flex-wrap items-center gap-3">
        <svg class="w-10 h-10 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
        </svg>
        Built
        <span class="font-script text-gray-400 lowercase text-6xl md:text-8xl align-middle pr-4">
          products
        </span>
      </h2>
      <p class="font-mono text-gray-500 text-[18px] uppercase tracking-widest mt-2">
        Keep learning, keep delivering
      </p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 mt-4">
      {projects.map((project) => (
        <div class="flex flex-col bg-[#050505] border border-white/10 rounded-2xl overflow-hidden hover:bg-white/[0.03] hover:border-white/50 hover:shadow-[inset_0_0_10px_rgba(255,255,255,0.05),_0_0_25px_rgba(255,255,255,0.1)] hover:-translate-y-1 transition-all duration-300 group">
          
          <!-- Image Container (Top 60%) -->
          <div class="relative w-full aspect-[4/3] sm:aspect-[16/9] lg:aspect-[4/3] overflow-hidden border-b border-white/5">
            <!-- Simulated Image / Gradient -->
            <div class={`absolute inset-0 w-full h-full ${project.imagePlaceholder} group-hover:scale-105 transition-transform duration-700 ease-out`}></div>
            
            <!-- Optional subtle overlay pattern -->
            <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 24px 24px;"></div>
          </div>

          <!-- Content Container (Bottom 40%) -->
          <div class="flex flex-col p-8 md:p-10 flex-grow relative z-10">
            <!-- Title -->
            <h3 class="text-3xl font-sans text-gray-100 font-medium tracking-tight mb-4 group-hover:text-white transition-colors">
              {project.title}
            </h3>

            <!-- Tags (Pill format like the image) -->
            <div class="flex flex-wrap gap-2 mb-6">
              {project.tags.map((tag) => (
                <span class="px-4 py-1.5 bg-gradient-to-b from-white/[0.08] to-white/[0.02] border border-white/10 rounded-full font-mono text-[12px] text-gray-200 uppercase tracking-widest shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] backdrop-blur-md hover:border-white/30 hover:text-white hover:shadow-[0_0_10px_rgba(255,255,255,0.1)] transition-all cursor-default">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Description -->
            <p class="font-sans text-xl text-gray-500 leading-relaxed mb-8 flex-grow">
              {project.description}
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 mt-auto">
              <!-- Live Button -->
              <a 
                href={project.liveLink}
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-2.5 bg-white/5 hover:bg-white/10 text-white font-mono text-[14px] uppercase tracking-widest border border-white/10 hover:border-white/30 rounded-lg transition-all flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
                Live Demo
              </a>
              
              <!-- Repository Button -->
              <a 
                href={project.repoLink}
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-2.5 bg-transparent hover:bg-white/5 text-gray-400 hover:text-white font-mono text-[14px] uppercase tracking-widest border border-transparent hover:border-white/10 rounded-lg transition-all flex items-center gap-2"
              >
                <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
                </svg>
                Repository
              </a>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>
