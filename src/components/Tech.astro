---
// src/components/Tech.astro

const technologies = [
  {
    name: "Python",
    tag: "BACKEND",
    icon: `<path d="M14.22 9.53c.12-.9.84-1.58 1.76-1.58h2.36c1 0 1.83.77 1.93 1.76l.11 1.05h-4.3v-.68c0-.2-.14-.38-.34-.41-.24-.04-.46.13-.5.37-.02.13-.02.26 0 .39l.26 2.37c.05.42.42.74.85.74h6.08c1.07 0 1.96-.83 2.05-1.9l.4-4.52c.1-.1.17-.23.2-.38.08-.47.16-1.12.21-1.91.07-1.1-.77-2.03-1.87-2.08H16.4c-2.3 0-4.22 1.79-4.38 4.09l-.16 2.22h2.29l.07-1.5zM10.15 14.47c-.12.9-.84 1.58-1.76 1.58H6.03c-1 0-1.83-.77-1.93-1.76l-.11-1.05h4.3v.68c0 .2.14.38.34.41.24.04.46-.13.5-.37.02-.13.02-.26 0-.39l-.26-2.37c-.05-.42-.42-.74-.85-.74H1.94c-1.07 0-1.96.83-2.05 1.9l-.4 4.52c-.1.1-.17.23-.2.38-.08.47-.16 1.12-.21 1.91-.07 1.1.77 2.03 1.87 2.08h7.02c2.3 0 4.22-1.79 4.38-4.09l.16-2.22h-2.29l-.07 1.5z"/>`,
  },
  {
    name: "FastAPI",
    tag: "FRAMEWORK",
    icon: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>`,
  },
  {
    name: "PostgreSQL",
    tag: "DATABASE",
    icon: `<path d="M12 2C6.48 2 2 4.01 2 6.5s4.48 4.5 10 4.5 10-2.01 10-4.5S17.52 2 12 2zm0 6.5c-4.41 0-8-1.57-8-3.5S7.59 1.5 12 1.5s8 1.57 8 3.5-3.59 3.5-8 3.5zm0 2.5c-4.41 0-8-1.57-8-3.5v2.5c0 1.93 3.59 3.5 8 3.5s8-1.57 8-3.5V7.5c0 1.93-3.59 3.5-8 3.5zm0 5.5c-4.41 0-8-1.57-8-3.5v2.5c0 1.93 3.59 3.5 8 3.5s8-1.57 8-3.5v-2.5c0 1.93-3.59 3.5-8 3.5z"/>`,
  },
  {
    name: "Docker",
    tag: "DEVOPS",
    icon: `<path d="M21 16.5c0 .38-.21.71-.53.88l-7.9 4.44c-.16.12-.36.18-.57.18-.21 0-.41-.06-.57-.18l-7.9-4.44A.991.991 0 0 1 3 16.5v-9c0-.38.21-.71.53-.88l7.9-4.44c.16-.12.36-.18.57-.18.21 0 .41.06.57.18l7.9 4.44c.32.17.53.5.53.88v9zM12 4.15L6.04 7.5 12 10.85l5.96-3.35L12 4.15zM5 15.91l6 3.38v-6.71L5 9.19v6.72zm14 0v-6.72l-6 3.39v6.71l6-3.38z"/>`,
  },
];

// Combine 4 copies of the list for smooth infinite scroll with smaller cards
const duplicatedTechnologies = [
  ...technologies,
  ...technologies,
  ...technologies,
  ...technologies,
];
---

<section id="tech" class="w-full overflow-hidden">
  <div class="flex flex-col gap-12">
    <div class="flex flex-col gap-2 px-4 md:px-0 max-w-7xl mx-auto w-full">
      <h2
        class="text-5xl md:text-7xl font-sans font-light text-gray-100 tracking-tight flex items-center gap-3"
      >
        <svg
          class="w-8 h-8 text-gray-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M8 9l3 3-3 3m5 0h3M4 6h16v12H4V6z"></path></svg
        >
        Tech <span
          class="font-script text-gray-400 lowercase text-6xl md:text-8xl align-middle"
          >stack</span
        >
      </h2>
      <p
        class="font-mono text-gray-500 text-[18px] uppercase tracking-widest mt-2"
      >
        Reliable tools that deliver
      </p>
    </div>

    <div class="relative w-full pb-8 pt-4">
      <div
        class="flex gap-4 md:gap-6 w-max animate-infiniteScroll hover:[animation-play-state:paused]"
      >
        {
          duplicatedTechnologies.map((tech) => (
            <div class="tech-card shrink-0 w-[140px] md:w-[160px] h-[150px] md:h-[170px] flex flex-col justify-between items-start bg-[#080808] border border-white/10 rounded-2xl p-5 hover:border-white/25 hover:-translate-y-1 transition-all duration-300 group">
              <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center text-[#111] shadow-lg shadow-white/10 group-hover:shadow-white/20 transition-all duration-300">
                <svg
                  class="w-6 h-6"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  set:html={tech.icon}
                />
              </div>

              <div>
                <h3 class="font-sans text-base md:text-lg text-gray-100 font-medium mb-2.5">
                  {tech.name}
                </h3>
                <div class="text-[9px] font-mono tracking-widest text-[#4fa4ff] border border-[#4fa4ff]/30 bg-[#4fa4ff]/10 rounded-full px-2.5 py-1 uppercase inline-block">
                  {tech.tag}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div
        class="pointer-events-none absolute inset-y-0 left-0 w-16 md:w-32 bg-gradient-to-r from-black via-black/80 to-transparent z-10"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-y-0 right-0 w-16 md:w-32 bg-gradient-to-l from-black via-black/80 to-transparent z-10"
      >
      </div>
    </div>
  </div>
</section>

<style is:global>
  @keyframes infiniteScroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .animate-infiniteScroll {
    animation: infiniteScroll 20s linear infinite;
  }

  /* Crystalline corner glow effect */
  .tech-card {
    position: relative;
    overflow: hidden;
  }

  .tech-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(
        circle 80px at 0% 0%,
        rgba(255, 255, 255, 0.15),
        transparent
      ),
      radial-gradient(
        circle 80px at 100% 0%,
        rgba(255, 255, 255, 0.15),
        transparent
      ),
      radial-gradient(
        circle 60px at 0% 100%,
        rgba(255, 255, 255, 0.08),
        transparent
      ),
      radial-gradient(
        circle 60px at 100% 100%,
        rgba(255, 255, 255, 0.08),
        transparent
      );
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .tech-card:hover::before {
    opacity: 1;
  }
</style>
