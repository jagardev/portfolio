---

<section id="tech" class="w-full">
  <Divider class="mb-16 xl:mb-24" />
  <div class="flex flex-col gap-12 max-w-7xl mx-auto px-4 md:px-0 reveal">
    <!-- Section Header -->
    <div class="flex flex-col gap-2 w-full">
      <h2
        class="text-5xl md:text-7xl font-sans font-light text-gray-100 tracking-tight flex flex-wrap items-center gap-3"
      >
        <svg
          class="w-10 h-10 text-gray-400 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M8 9l3 3-3 3m5 0h3M4 6h16v12H4V6z"></path>
        </svg>
        Tech
        <span
          class="font-script text-gray-400 lowercase text-6xl md:text-8xl align-middle pr-4"
        >
          stack
        </span>
      </h2>
      <p
        class="font-mono text-gray-500 text-[18px] uppercase tracking-widest mt-2"
      >
        Reliable tools that deliver
      </p>
    </div>

    <!-- Tech Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 mt-4">
      {
        techCategories.map((category) => (
          <div class="flex flex-col p-8 transition-all duration-500">
            
            <!-- Category Header -->
            <div class="flex items-center gap-5 mb-10 border-b border-white/5 pb-6 group">
              <div class="w-14 h-14 shrink-0 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-gray-500 group-hover:text-white group-hover:bg-white/10 group-hover:border-white/40 group-hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] transition-all duration-500">
                <svg
                  class="w-7 h-7 group-hover:drop-shadow-[0_0_8px_rgba(255,255,255,0.8)] transition-all duration-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  set:html={category.icon}
                />
              </div>

              <div>
                <h3 class="font-mono text-[26px] md:text-[26px] text-gray-200 uppercase tracking-widest group-hover:text-white transition-colors duration-300">
                  {category.title}
                </h3>
                <p class="font-sans text-[18px] md:text-[20px] text-gray-500 mt-1">
                  {category.description}
                </p>
              </div>
            </div>

            <!-- Floating Technologies Grid -->
            <div class="flex flex-wrap gap-8 justify-center md:justify-start">
              {category.technologies.map((tech) => (
                <div class="flex flex-col items-center justify-center gap-3 group/tech w-16 cursor-default">
                  {/* Large Icon with direct SVG injection */}
                  <svg 
                    class="w-12 h-12 text-gray-450 group-hover/tech:text-white group-hover/tech:-translate-y-1 transition-all duration-300 drop-shadow-none group-hover/tech:drop-shadow-[0_0_15px_rgba(255,255,255,0.6)]" 
                    fill="currentColor" 
                    viewBox={tech.viewBox || "0 0 24 24"} 
                    set:html={tech.icon}
                  ></svg>
                  
                  {/* Tiny Name underneath */}
                  <span class="font-mono text-[14px] uppercase tracking-widest text-gray-500 group-hover/tech:text-gray-300 transition-colors text-center w-max">
                    {tech.name}
                  </span>
                </div>
              ))}
            </div>
            
          </div>
        ))
      }
    </div>
  </div>
</section>
