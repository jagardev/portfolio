---
import Divider from "./Divider.astro";

// Academic qualifications displayed on the timeline
const educationItems = [
  {
    year: "2026 - Present",
    title: "Specialization Diploma in AI & Big Data",
    institution: "EQF Level 5 | IES Zaidin Vergeles - Granada",
    description: "Specialization in machine learning algorithms, deep learning, and scalable data architectures. Final project to be based on predictive models for backend optimization."
  },
  {
    year: "2024 - 2026",
    title: "Higher Diploma in Web Applications Development",
    institution: "EQF Level 5 | CESUR - Malaga",
    description: "Core foundation in data structures, algorithms, and software engineering principles."
  },
  {
    year: "2015 - 2019",
    title: "Vocational Certificate in Business Administration",
    institution: "EQF Level 4 | FP Eden - Palencia",
    description: "Hands-on experience understanding business logic and real life problem solving skills."
  },
  {
    year: "2009 - 2014",
    title: "Compulsory Secondary Education",
    institution: "EQF Level 3 | San Jose High School - Palencia",
    description: "The start of the knowledge-seeking journey."
  }
];
---

<section id="education" class="w-full">
  <Divider class="mb-16 xl:mb-24" />
  
  <div class="flex flex-col gap-12 max-w-7xl mx-auto w-full px-4 md:px-0 reveal">
    
    <!-- Section Header -->
    <div class="flex flex-col gap-2">
      <h2 class="text-5xl md:text-7xl font-sans font-light text-gray-100 tracking-tight flex flex-wrap items-center gap-3">
        <!-- Graduation cap icon -->
        <svg class="w-10 h-10 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14v7"></path>
        </svg>
        Academic <span class="font-script text-gray-400 lowercase text-6xl md:text-8xl align-middle pr-4">journey</span>
      </h2>
      <p class="font-mono text-gray-500 text-[18px] uppercase tracking-widest mt-2">Knowledge i keep expanding</p>
    </div>

    <!-- Timeline layout with vertical connector line -->
    <!-- Left margin offsets the line slightly from the screen edge on mobile -->
    <div class="relative ml-2 md:ml-10 mt-6">
      
      <!-- Vertical connector line stretching the full height of the entries -->
      <div class="absolute left-[7px] top-2 bottom-2 w-px bg-white/20"></div>

      <!-- Education entry list -->
      <div class="flex flex-col gap-10">
        {educationItems.map((item) => (
          // The group class enables coordinated hover styling on the dot and text
          <div class="relative pl-10 md:pl-12 group">
            
            {/* The Dot */}
            {/* 
                Timeline dot positioned on the vertical line.
                Hover state applies glow and fill via the group utility.
            */}
            <div class="absolute left-0 top-1.5 w-4 h-4 rounded-full bg-[#050505] border-2 border-gray-600 group-hover:border-white group-hover:shadow-[0_0_15px_rgba(255,255,255,0.8)] group-hover:bg-white transition-all duration-300 z-10"></div>
            
            {/* Entry content */}
            <div class="flex flex-col gap-1.5 cursor-default">
              {/* Date range badge */}
              <span class="font-mono text-[13px] font-semibold text-gray-100/90 uppercase tracking-widest bg-gray-400/10 border border-gray-100/50 px-2 py-0.5 rounded-full w-max">
                {item.year}
              </span>
              
              {/* Qualification title and institution */}
              <h3 class="font-sans text-2xl md:text-3xl text-gray-200 font-medium mt-1 group-hover:text-white transition-colors duration-300">
                {item.title}
              </h3>
              <h4 class="font-sans text-[16px] md:text-[18px] text-gray-400 italic">
                {item.institution}
              </h4>
              
              {/* Qualification description */}
              <p class="font-mono text-gray-350 md:text-[18px] text-[18px] leading-relaxed mt-2 max-w-2xl group-hover:text-gray-200 transition-colors duration-300">
                {item.description}
              </p>
            </div>
            
          </div>
        ))}
      </div>

    </div>

  </div>
</section>